# Copy to .env and fill in. .env is gitignored.

# Anthropic API key for extraction and classification.
ANTHROPIC_API_KEY=

# Neo4j, matching docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=studydefinition

# Optional. A CDISC Library API key on a member-tier subscription unlocks the
# CDISC Library and the usdm PyPI package. A non-member key authenticates but
# returns "Members-only content" on every MDR endpoint, so nothing here depends
# on it. See BACKGROUND.md, Public artifacts.
CDISC_API_KEY=
