# Copy to .env and fill in. .env is gitignored.

# The Anthropic API key is used for extraction and classification.
ANTHROPIC_API_KEY=

# These are the Neo4j settings, and they match docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=studydefinition

# The CDISC key is optional. A CDISC Library API key on a member-tier subscription unlocks the
# CDISC Library and the usdm package on PyPI, the Python package index. A non-member key authenticates but
# returns "Members-only content" on every metadata repository (MDR) endpoint, so nothing here depends
# on it.
CDISC_API_KEY=
