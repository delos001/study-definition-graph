# Secrets
.env
.env.*
!.env.example

# Pinned downloads and pipeline output: everything is reproducible from
# manifests/ (committed, at the root), so the files themselves are not
# committed. READMEs written in these folders are.
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
standards/**
!standards/**/
!standards/**/README.md

# Model response cache
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
