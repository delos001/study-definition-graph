# Secrets
.env
.env.*
!.env.example

# Pinned downloads and pipeline output. Every download under inputs/ is
# restorable from manifests/ (committed, at the root), so the files themselves
# are not committed. READMEs and .gitkeep placeholders written in these
# folders are. The worked-examples README is unignored by name, not by
# wildcard, so a README a future download ships is not committed by accident.
inputs/**
!inputs/**/
!inputs/README.md
!inputs/standards/**/README.md
!inputs/worked_examples/README.md
!inputs/study_documents/.gitkeep
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# Model response cache
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
