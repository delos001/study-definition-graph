# Secrets
.env
.env.*
!.env.example

# Data: everything is reproducible from manifests, so nothing is committed.
# data/raw/ is immutable once downloaded and is never edited in place, so the
# manifests that make it re-fetchable live outside it, in data/manifests/.
data/**
!data/**/
!data/**/.gitkeep
!data/manifests/**

# Model response cache
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
