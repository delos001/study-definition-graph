#!/bin/sh
#
# Pre-commit hook for study-definition-graph.
#
# Enabled by `git config core.hooksPath .githooks`, which the README's setup
# section runs after the clone. Committed rather than left in .git/hooks so a
# fresh clone gets it.
#
# Only checks that need no third-party packages belong here, so the hook works
# from any terminal whether or not the sdg conda environment is active. That
# rules out check_facts.py (imports pymupdf and openpyxl) and
# verify_manifests.py (hashes 41 files). Both are manual runs; see the README.

set -e

# scripts/README.md is generated from each script's header block. A commit that
# edits a header without regenerating ships an index that disagrees with the
# scripts it describes, which is the exact drift the generator exists to stop.
# Pure standard library, so plain `python` is enough.
python scripts/build_index.py --check || {
  echo "pre-commit: run 'python scripts/build_index.py' and stage scripts/README.md"
  exit 1
}
