#!/bin/sh
#
# Pre-commit hook for study-definition-graph.
#
# Enabled by `git config core.hooksPath .githooks`, which the README's setup
# section runs after the clone. Committed rather than left in .git/hooks so a
# fresh clone gets it.
#
# The first three checks use only the standard library, so they run from any
# terminal. The fourth needs ruff and mypy from the sdg conda environment; its
# script finds them on the path when that environment is active and runs them
# through conda when it is not. check_facts.py (reads every pinned file) and
# acquire_sources (hashes 42 files) stay manual runs; see the README.

set -e

# scripts/README.md is generated from each script's header block. A commit that
# edits a header without regenerating ships an index that disagrees with the
# scripts it describes, which is the exact drift the generator exists to stop.
# Pure standard library, so plain `python` is enough.
python scripts/build_index.py --check || {
  echo "pre-commit: run 'python scripts/build_index.py' and stage scripts/README.md"
  exit 1
}

# Every Python file in the package and in scripts/ opens with the header block
# the writing_python_files rule requires. A file that lacks one, or has its fields out of order, is
# refused here so the rule holds whoever made the edit. Standard library only.
python scripts/verify_headers.py || {
  echo "pre-commit: fix the header blocks named above, then commit again"
  exit 1
}

# tests/validation_inventory.csv is generated from the checks in the test files.
# A commit that changes a check without regenerating the inventory ships a list
# that disagrees with the checks it describes. Standard library only.
python scripts/build_inventory.py --check || {
  echo "pre-commit: run 'python scripts/build_inventory.py' and stage tests/validation_inventory.csv"
  exit 1
}

# Every Python file passes ruff format, ruff check and mypy, as configured in
# pyproject.toml. Each tool prints its own report, so a refused commit names
# the file and the line.
python scripts/check_python_files.py --quiet || {
  echo "pre-commit: fix what ruff or mypy reported above, then commit again"
  exit 1
}
